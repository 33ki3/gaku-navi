{
  "name": "gaku-navi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "knip": {
    "entry": [
      "i18next.config.ts",
      "src/main.tsx",
      "src/appBootstrap.tsx",
      "scripts/regression.ts",
      "scripts/cpSatSummary.ts"
    ],
    "ignore": [
      "src/i18n/i18next.d.ts",
      "src/env.d.ts"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "checks": "eslint . && prettier --check \"src/**/*.{ts,tsx}\" && knip --reporter compact && i18next-cli status && i18next-cli status --unused && tsc -p tsconfig.app.json --noEmit && vitest run",
    "cp-sat": "RUN_CP_SAT_VERIFICATION=1 vitest run --no-file-parallelism src/__tests__/verification/cpSatOptimizer.test.ts src/__tests__/verification/optimizerMatrix.test.ts",
    "regression": "tsc -p scripts/tsconfig.json && node node_modules/.tmp/regression/regression.js"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.19",
    "i18next": "^25.8.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "i18next-cli": "^1.69.0",
    "jsdom": "^27.0.1",
    "knip": "^5.85.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
